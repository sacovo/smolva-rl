{
  "slurm": {
    "cpus_per_task": 32,
    "num_jobs": 2,
    "mem": "128G",
    "gres": "gpu:h200:2",
    "partition": "h200",
    "nodes": 1,
    "ntasks_per_node": 1,
    "time": "24:00:00",
    "output": "logs/%x_%j.out",
    "error": "logs/%x_%j.err",
    "dependency_type": "afterany",
    "job_name": "recap_libero_aug"
  },
  "training": {
    "precomputed_advantages": "outputs/libero/task_advantages_HuggingFaceVLA_libero.npy",
    "num_vlm_layers": 16,
    "thresholds_path": "outputs/libero/task_thresholds_HuggingFaceVLA_libero.json",
    "dataset_repo_id": "HuggingFaceVLA/libero",
    "accumulation_steps": 8,
    "batch_size": 32,
    "warmup_steps": 200,
    "steps": 250000,
    "fm_loss_weight": 4.0,
    "loss_n_action_steps": 20,
    "action_chunk_size": 20,
    "save_dir": "outputs/libero_aug/",
    "duration": "24:00:00",
    "job_name": "recap_libero_aug",
    "resume_from": "auto",
    "augmentation": true
  }
}
